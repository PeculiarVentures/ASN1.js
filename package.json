{
  "name": "asn1js",
  "version": "4.1.0",
  "description": "Pure JavaScript ASN.1 BER/DER encoder and decoder with schema validation, for browsers and Node.js. ASN.1 is the basis of X.509 certificates and many other protocols used on the web.",
  "keywords": [
    "asn1",
    "parser",
    "asn.1",
    "ber",
    "der",
    "sequence",
    "set",
    "bitstring",
    "octetstring",
    "utctime",
    "utf8string",
    "bmpstring",
    "universalstring",
    "generalizedtime"
  ],
  "license": "BSD-3-Clause",
  "type": "module",
  "sideEffects": false,
  "author": {
    "email": "yury@strozhevsky.com",
    "name": "Yury Strozhevsky"
  },
  "contributors": [
    {
      "email": "rmh@unmitigatedrisk.com",
      "name": "Ryan Hurst"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PeculiarVentures/ASN1.js"
  },
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ],
  "main": "./build/index.js",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": "./build/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "tsdown",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@peculiar/utils": "^4.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "asn1-test-suite": "^1.0.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.5.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.7.0",
      "onFail": "warn"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
