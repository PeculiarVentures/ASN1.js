{
  // This file is not used in compilation. It is here just for a nice editor experience.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // TypeScript 6 deprecates baseUrl; paths resolve relative to this file instead.
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    }
  },
  // The examples have their own tsconfig that checks them against the library source.
  "exclude": ["node_modules", "build", "docs/examples"]
}
